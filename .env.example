# ============================================================
# EmailJS Configuration
# ============================================================
# Required for the contact form to work
# Sign up at https://www.emailjs.com/ and create:
# 1. An email service (Gmail, Outlook, etc.)
# 2. An email template
# 3. Get your public key from the integration page

VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# ============================================================
# Portfolio Configuration
# ============================================================
# Most portfolio data is configured in src/config/portfolio.tsx
# Update that file to customize:
# - Personal information (name, bio, title)
# - Social links (GitHub, LinkedIn, Email)
# - Projects and experience data
# - Skills and feature cards
#
# Only use this .env file for sensitive data that should not
# be committed to version control.
